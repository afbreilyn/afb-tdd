+package domain_test
+
+import (
+	"testing"
+
+	"evalfixture/domain"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestSummary_noTags(t *testing.T) {
+	r := domain.Report{Title: "Q1 Report"}
+	assert.Equal(t, "Q1 Report", r.Summary())
+}
+
+func TestSummary_withTags(t *testing.T) {
+	r := domain.Report{
+		Title: "Q1 Report",
+		Tags:  map[string]string{"env": "prod", "team": "payments"},
+	}
+	assert.Equal(t, "Q1 Report [env=prod, team=payments]", r.Summary())
+}
