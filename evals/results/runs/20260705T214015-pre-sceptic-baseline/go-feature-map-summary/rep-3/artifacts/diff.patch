@@ -1,7 +1,28 @@
 package domain
 
+import (
+	"sort"
+	"strings"
+)
+
 // Report is a titled document with free-form tags.
 type Report struct {
 	Title string
 	Tags  map[string]string
 }
+
+func (r Report) Summary() string {
+	if len(r.Tags) == 0 {
+		return r.Title
+	}
+	keys := make([]string, 0, len(r.Tags))
+	for k := range r.Tags {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	pairs := make([]string, 0, len(keys))
+	for _, k := range keys {
+		pairs = append(pairs, k+"="+r.Tags[k])
+	}
+	return r.Title + " [" + strings.Join(pairs, ", ") + "]"
+}
