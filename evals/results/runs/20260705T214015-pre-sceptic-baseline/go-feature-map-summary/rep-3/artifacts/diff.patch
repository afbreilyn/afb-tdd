+package domain_test
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"evalfixture/domain"
+)
+
+func Test_Summary_NoTags(t *testing.T) {
+	r := domain.Report{Title: "Q1 Report"}
+	assert.Equal(t, "Q1 Report", r.Summary())
+}
+
+func Test_Summary_WithTags(t *testing.T) {
+	r := domain.Report{Title: "Q1 Report", Tags: map[string]string{"env": "prod"}}
+	assert.Equal(t, "Q1 Report [env=prod]", r.Summary())
+}
+
+func Test_Summary_MultipleTagsStableOrder(t *testing.T) {
+	r := domain.Report{Title: "Q1 Report", Tags: map[string]string{"team": "payments", "env": "prod"}}
+	assert.Equal(t, "Q1 Report [env=prod, team=payments]", r.Summary())
+}
