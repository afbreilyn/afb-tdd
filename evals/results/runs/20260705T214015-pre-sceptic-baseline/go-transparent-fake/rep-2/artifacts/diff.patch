@@ -0,0 +1,29 @@
+package contract
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"evalfixture/hasher"
+)
+
+// RunHasherContract verifies any Hasher implementation. Run it against every
+// fake AND the real implementation so the fake can't drift.
+func RunHasherContract(t *testing.T, h hasher.Hasher) {
+	t.Helper()
+
+	t.Run("Hash produces a non-empty string", func(t *testing.T) {
+		assert.NotEmpty(t, h.Hash("password"))
+	})
+
+	t.Run("Verify returns true for the matching plain text", func(t *testing.T) {
+		hashed := h.Hash("password")
+		assert.True(t, h.Verify("password", hashed))
+	})
+
+	t.Run("Verify returns false for a different plain text", func(t *testing.T) {
+		hashed := h.Hash("password")
+		assert.False(t, h.Verify("other", hashed))
+	})
+}
