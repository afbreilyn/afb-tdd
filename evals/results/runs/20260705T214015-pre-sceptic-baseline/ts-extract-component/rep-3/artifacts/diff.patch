diff --git a/src/components/SubscriberList.test.tsx b/src/components/SubscriberList.test.tsx
new file mode 100644
index 0000000..c06332e
--- /dev/null
+++ b/src/components/SubscriberList.test.tsx
@@ -0,0 +1,39 @@
+import { render, screen } from "@testing-library/react";
+import { SubscriberList } from "./SubscriberList";
+import { createSubscriber } from "../testing/factories";
+
+describe("SubscriberList", () => {
+  it("renders an empty list", () => {
+    render(<SubscriberList subscribers={[]} />);
+
+    expect(screen.getByRole("list", { name: "Subscribers" })).toBeVisible();
+    expect(screen.queryAllByRole("listitem")).toHaveLength(0);
+  });
+
+  it("renders each subscriber's name", () => {
+    const subscribers = [
+      createSubscriber({ id: "s1", name: "Ada Lovelace" }),
+      createSubscriber({ id: "s2", name: "Grace Hopper" }),
+    ];
+
+    render(<SubscriberList subscribers={subscribers} />);
+
+    expect(screen.getByText("Ada Lovelace")).toBeVisible();
+    expect(screen.getByText("Grace Hopper")).toBeVisible();
+  });
+
+  it("renders each subscriber's email as a mailto link", () => {
+    render(<SubscriberList subscribers={[createSubscriber({ email: "ada@example.com" })]} />);
+
+    expect(screen.getByRole("link", { name: "ada@example.com" })).toHaveAttribute(
+      "href",
+      "mailto:ada@example.com",
+    );
+  });
+
+  it("renders each subscriber's topics", () => {
+    render(<SubscriberList subscribers={[createSubscriber({ topics: ["product", "updates"] })]} />);
+
+    expect(screen.getByText("product, updates")).toBeVisible();
+  });
+});
diff --git a/src/components/SubscriberList.tsx b/src/components/SubscriberList.tsx
new file mode 100644
