 package domain
 
+import (
+	"fmt"
+	"maps"
+	"slices"
+	"strings"
+)
+
 // Report is a titled document with free-form tags.
 type Report struct {
 	Title string
 	Tags  map[string]string
 }
+
+func (r Report) Summary() string {
+	if len(r.Tags) == 0 {
+		return r.Title
+	}
+	keys := slices.Sorted(maps.Keys(r.Tags))
+	pairs := make([]string, len(keys))
+	for i, k := range keys {
+		pairs[i] = fmt.Sprintf("%s=%s", k, r.Tags[k])
+	}
+	return fmt.Sprintf("%s [%s]", r.Title, strings.Join(pairs, ", "))
+}
