+package domain_test
+
+import (
+	"testing"
+
+	"evalfixture/domain"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestReportSummary(t *testing.T) {
+	t.Run("no tags", func(t *testing.T) {
+		r := domain.Report{Title: "Q1 Report", Tags: map[string]string{}}
+		assert.Equal(t, "Q1 Report", r.Summary())
+	})
+
+	t.Run("single tag", func(t *testing.T) {
+		r := domain.Report{Title: "Q1 Report", Tags: map[string]string{"env": "prod"}}
+		assert.Equal(t, "Q1 Report [env=prod]", r.Summary())
+	})
+
+	t.Run("multiple tags sorted", func(t *testing.T) {
+		r := domain.Report{Title: "Q1 Report", Tags: map[string]string{"team": "payments", "env": "prod"}}
+		assert.Equal(t, "Q1 Report [env=prod, team=payments]", r.Summary())
+	})
+}
