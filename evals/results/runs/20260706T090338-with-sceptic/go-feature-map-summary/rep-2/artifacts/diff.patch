+package domain_test
+
+import (
+	"testing"
+
+	"evalfixture/domain"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestReport_Summary_no_tags(t *testing.T) {
+	r := domain.Report{Title: "Q1 Report", Tags: map[string]string{}}
+	assert.Equal(t, "Q1 Report", r.Summary())
+}
+
+func TestReport_Summary_multiple_tags_sorted(t *testing.T) {
+	r := domain.Report{
+		Title: "Q1 Report",
+		Tags:  map[string]string{"team": "payments", "env": "prod"},
+	}
+	assert.Equal(t, "Q1 Report [env=prod, team=payments]", r.Summary())
+}
