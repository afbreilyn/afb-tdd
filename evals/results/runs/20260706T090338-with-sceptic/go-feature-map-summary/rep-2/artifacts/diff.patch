@@ -1,7 +1,25 @@
 package domain
 
+import (
+	"maps"
+	"slices"
+	"strings"
+)
+
 // Report is a titled document with free-form tags.
 type Report struct {
 	Title string
 	Tags  map[string]string
 }
+
+func (r Report) Summary() string {
+	if len(r.Tags) == 0 {
+		return r.Title
+	}
+	keys := slices.Sorted(maps.Keys(r.Tags))
+	parts := make([]string, len(keys))
+	for i, k := range keys {
+		parts[i] = k + "=" + r.Tags[k]
+	}
+	return r.Title + " [" + strings.Join(parts, ", ") + "]"
+}
