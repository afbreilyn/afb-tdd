--- /dev/null
+++ b/hasher/contract/hasher.go
@@ -0,0 +1,33 @@
+package contract
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"evalfixture/hasher"
+)
+
+// RunHasherContract verifies any Hasher implementation. Run it against both
+// the fake and the real SHA256 implementation so the fake cannot drift.
+func RunHasherContract(t *testing.T, h hasher.Hasher) {
+	t.Helper()
+
+	t.Run("Hash returns a non-empty string", func(t *testing.T) {
+		result := h.Hash("secret")
+
+		assert.NotEmpty(t, result)
+	})
+
+	t.Run("Verify returns true for the matching plaintext", func(t *testing.T) {
+		hashed := h.Hash("secret")
+
+		assert.True(t, h.Verify("secret", hashed))
+	})
+
+	t.Run("Verify returns false for a different plaintext", func(t *testing.T) {
+		hashed := h.Hash("secret")
+
+		assert.False(t, h.Verify("wrong", hashed))
+	})
+}
