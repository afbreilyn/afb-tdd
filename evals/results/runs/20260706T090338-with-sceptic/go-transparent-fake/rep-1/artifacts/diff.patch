diff --git a/hasher/sha256hasher/sha256hasher.go b/hasher/sha256hasher/sha256hasher.go
new file mode 100644
index 0000000..c5b1110
--- /dev/null
+++ b/hasher/sha256hasher/sha256hasher.go
@@ -0,0 +1,19 @@
+package sha256hasher
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+)
+
+type SHA256Hasher struct{}
+
+func New() *SHA256Hasher { return &SHA256Hasher{} }
+
+func (h *SHA256Hasher) Hash(plain string) string {
+	sum := sha256.Sum256([]byte(plain))
+	return hex.EncodeToString(sum[:])
+}
+
+func (h *SHA256Hasher) Verify(plain, hashed string) bool {
+	return h.Hash(plain) == hashed
+}
