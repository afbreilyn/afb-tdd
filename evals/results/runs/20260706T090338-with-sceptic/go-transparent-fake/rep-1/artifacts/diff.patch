@@ -0,0 +1,10 @@
+package fakes
+
+// FakeHasher is a transparent fake: output encodes the input so tests can
+// assert on both sides without depending on a real hash algorithm.
+type FakeHasher struct{}
+
+func NewFakeHasher() *FakeHasher { return &FakeHasher{} }
+
+func (f *FakeHasher) Hash(plain string) string        { return "hashed:" + plain }
+func (f *FakeHasher) Verify(plain, hashed string) bool { return "hashed:"+plain == hashed }
