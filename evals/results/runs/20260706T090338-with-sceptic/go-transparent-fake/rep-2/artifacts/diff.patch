new file mode 100644
index 0000000..6f47dd7
--- /dev/null
+++ b/hasher/contract/hasher.go
@@ -0,0 +1,47 @@
+package contract
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"evalfixture/hasher"
+)
+
+// RunHasherContract verifies any Hasher implementation. Run it against every
+// fake AND the real implementation so the fake cannot drift.
+func RunHasherContract(t *testing.T, h hasher.Hasher) {
+	t.Helper()
+
+	t.Run("Hash returns non-empty output", func(t *testing.T) {
+		result := h.Hash("anypassword")
+
+		assert.NotEmpty(t, result)
+	})
+
+	t.Run("same input always produces same hash", func(t *testing.T) {
+		first := h.Hash("password")
+		second := h.Hash("password")
+
+		assert.Equal(t, first, second)
+	})
+
+	t.Run("different inputs produce different hashes", func(t *testing.T) {
+		a := h.Hash("password1")
+		b := h.Hash("password2")
+
+		assert.NotEqual(t, a, b)
+	})
+
+	t.Run("Verify returns true for matching plain and hash", func(t *testing.T) {
+		hashed := h.Hash("mysecret")
+
+		assert.True(t, h.Verify("mysecret", hashed))
+	})
+
+	t.Run("Verify returns false for non-matching plain and hash", func(t *testing.T) {
+		hashed := h.Hash("correct")
+
+		assert.False(t, h.Verify("wrong", hashed))
+	})
+}
