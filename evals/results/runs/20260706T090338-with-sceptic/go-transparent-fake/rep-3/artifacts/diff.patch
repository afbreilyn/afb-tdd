+}
diff --git a/hasher/sha256/hasher.go b/hasher/sha256/hasher.go
new file mode 100644
index 0000000..b4f1775
--- /dev/null
+++ b/hasher/sha256/hasher.go
@@ -0,0 +1,19 @@
+package sha256
+
+import (
+	gsha256 "crypto/sha256"
+	"encoding/hex"
+)
+
+type Hasher struct{}
+
+func NewHasher() *Hasher { return &Hasher{} }
+
+func (h *Hasher) Hash(plain string) string {
+	sum := gsha256.Sum256([]byte(plain))
+	return hex.EncodeToString(sum[:])
+}
+
+func (h *Hasher) Verify(plain, hashed string) bool {
+	return h.Hash(plain) == hashed
+}
