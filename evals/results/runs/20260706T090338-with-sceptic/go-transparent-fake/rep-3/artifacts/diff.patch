@@ -0,0 +1,27 @@
+package contract
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"evalfixture/hasher"
+)
+
+// RunHasherContract verifies any Hasher implementation. Run it against every
+// fake AND the real implementation so the fake can't drift.
+func RunHasherContract(t *testing.T, h hasher.Hasher) {
+	t.Helper()
+
+	t.Run("verify returns true for a matching hash", func(t *testing.T) {
+		hashed := h.Hash("s3cr3t")
+
+		assert.True(t, h.Verify("s3cr3t", hashed))
+	})
+
+	t.Run("verify returns false for a non-matching value", func(t *testing.T) {
+		hashed := h.Hash("s3cr3t")
+
+		assert.False(t, h.Verify("wrong", hashed))
+	})
+}
