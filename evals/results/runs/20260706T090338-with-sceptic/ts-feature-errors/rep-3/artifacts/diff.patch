@@ -34,3 +38,39 @@ export async function subscribe(email: string, topic: string): Promise<Subscribe
   }
   return { kind: "subscribed", subscriberId: (body as { subscriberId: string }).subscriberId };
 }
+
+export type UnsubscribeResult =
+  | { kind: "unsubscribed" }
+  | { kind: "email_error"; message: string }
+  | { kind: "topic_error"; message: string }
+  | { kind: "not_subscribed"; message: string }
+  | { kind: "connection_error"; message: string };
+
+export async function unsubscribe(email: string, topic: string): Promise<UnsubscribeResult> {
+  if (!isValidEmail(email)) {
+    return { kind: "email_error", message: `"${email}" is not a valid email address` };
+  }
+  if (!KNOWN_TOPICS.includes(topic as Topic)) {
+    return { kind: "topic_error", message: `"${topic}" is not a known topic` };
+  }
+
+  let body: unknown;
+  try {
+    body = await postApi("newsletter.unsubscribe", { email, topic });
+  } catch {
+    return { kind: "connection_error", message: "could not reach the newsletter service" };
+  }
+
+  if (
+    typeof body === "object" &&
+    body !== null &&
+    (body as { error?: unknown }).error === "not_subscribed"
+  ) {
+    return {
+      kind: "not_subscribed",
+      message: `${email} is not subscribed to ${topic}`,
+    };
+  }
+
+  return { kind: "unsubscribed" };
+}
