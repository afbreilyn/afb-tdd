diff --git a/domain/report.go b/domain/report.go
index 2abf1e3..bbe3e45 100644
--- a/domain/report.go
+++ b/domain/report.go
@@ -1,7 +1,30 @@
 package domain
 
+import (
+	"fmt"
+	"maps"
+	"slices"
+	"strings"
+)
+
 // Report is a titled document with free-form tags.
 type Report struct {
 	Title string
 	Tags  map[string]string
 }
+
+// Summary renders the title, followed by any tags as sorted, comma-separated
+// key=value pairs in brackets.
+func (r Report) Summary() string {
+	if len(r.Tags) == 0 {
+		return r.Title
+	}
+
+	keys := slices.Sorted(maps.Keys(r.Tags))
+	pairs := make([]string, len(keys))
+	for i, k := range keys {
+		pairs[i] = fmt.Sprintf("%s=%s", k, r.Tags[k])
+	}
+
+	return fmt.Sprintf("%s [%s]", r.Title, strings.Join(pairs, ", "))
+}
diff --git a/domain/report_test.go b/domain/report_test.go
