@@ -0,0 +1,30 @@
+package domain_test
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"evalfixture/domain"
+)
+
+func TestSummary_NoTags_ReturnsTitleOnly(t *testing.T) {
+	report := domain.Report{Title: "Q1 Report"}
+
+	assert.Equal(t, "Q1 Report", report.Summary())
+}
+
+func TestSummary_OneTag_AppendsBracketedKeyValue(t *testing.T) {
+	report := domain.Report{Title: "Q1 Report", Tags: map[string]string{"env": "prod"}}
+
+	assert.Equal(t, "Q1 Report [env=prod]", report.Summary())
+}
+
+func TestSummary_MultipleTags_SortsAndJoinsWithCommas(t *testing.T) {
+	report := domain.Report{
+		Title: "Q1 Report",
+		Tags:  map[string]string{"team": "payments", "env": "prod"},
+	}
+
+	assert.Equal(t, "Q1 Report [env=prod, team=payments]", report.Summary())
+}
