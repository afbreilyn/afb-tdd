+package domain_test
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/suite"
+
+	"evalfixture/domain"
+)
+
+type reportSuite struct {
+	suite.Suite
+}
+
+func TestReportSuite(t *testing.T) {
+	suite.Run(t, new(reportSuite))
+}
+
+func (s *reportSuite) Test_Summary_TitleOnly_NoTags() {
+	report := domain.Report{Title: "Q1 Report"}
+
+	s.Equal("Q1 Report", report.Summary())
+}
+
+func (s *reportSuite) Test_Summary_SingleTag_RendersBracketedKeyValue() {
+	report := domain.Report{Title: "Q1 Report", Tags: map[string]string{"env": "prod"}}
+
+	s.Equal("Q1 Report [env=prod]", report.Summary())
+}
+
+func (s *reportSuite) Test_Summary_MultipleTags_SortedAlphabeticallyByKey() {
+	report := domain.Report{
+		Title: "Q1 Report",
+		Tags: map[string]string{
+			"team":   "payments",
+			"env":    "prod",
+			"region": "us",
+		},
+	}
+
+	s.Equal("Q1 Report [env=prod, region=us, team=payments]", report.Summary())
+}
