diff --git a/domain/report.go b/domain/report.go
index 2abf1e3..e99416c 100644
--- a/domain/report.go
+++ b/domain/report.go
@@ -1,7 +1,27 @@
 package domain
 
+import (
+	"fmt"
+	"maps"
+	"slices"
+	"strings"
+)
+
 // Report is a titled document with free-form tags.
 type Report struct {
 	Title string
 	Tags  map[string]string
 }
+
+// Summary renders the title followed by its tags as sorted, comma-separated
+// key=value pairs in brackets. A report with no tags renders just the title.
+func (r *Report) Summary() string {
+	if len(r.Tags) == 0 {
+		return r.Title
+	}
+	pairs := make([]string, 0, len(r.Tags))
+	for _, key := range slices.Sorted(maps.Keys(r.Tags)) {
+		pairs = append(pairs, fmt.Sprintf("%s=%s", key, r.Tags[key]))
+	}
+	return fmt.Sprintf("%s [%s]", r.Title, strings.Join(pairs, ", "))
+}
diff --git a/domain/report_test.go b/domain/report_test.go
new file mode 100644
index 0000000..3664016
--- /dev/null
+++ b/domain/report_test.go
@@ -0,0 +1,33 @@
+package domain_test
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"evalfixture/domaintest"
+)
+
+func TestSummary_NoTags_ReturnsTitleOnly(t *testing.T) {
+	report := domaintest.NewReport(domaintest.WithTitle("Q1 Report"))
+
+	assert.Equal(t, "Q1 Report", report.Summary())
+}
+
+func TestSummary_OneTag_AppendsKeyValueInBrackets(t *testing.T) {
+	report := domaintest.NewReport(
+		domaintest.WithTitle("Q1 Report"),
+		domaintest.WithTags(map[string]string{"team": "payments"}),
+	)
+
+	assert.Equal(t, "Q1 Report [team=payments]", report.Summary())
+}
+
+func TestSummary_MultipleTags_JoinsSortedByKeyCommaSeparated(t *testing.T) {
+	report := domaintest.NewReport(
+		domaintest.WithTitle("Q1 Report"),
+		domaintest.WithTags(map[string]string{"team": "payments", "env": "prod"}),
+	)
+
+	assert.Equal(t, "Q1 Report [env=prod, team=payments]", report.Summary())
+}
