 }
+
+type reportConfig struct {
+	title string
+	tags  map[string]string
+}
+
+type ReportOption func(*reportConfig)
+
+func WithTitle(title string) ReportOption {
+	return func(c *reportConfig) { c.title = title }
+}
+
+func WithTags(tags map[string]string) ReportOption {
+	return func(c *reportConfig) { c.tags = tags }
+}
+
+// NewReport builds a complete report with sensible defaults.
+// Override only what the test cares about.
+func NewReport(opts ...ReportOption) *domain.Report {
+	cfg := &reportConfig{
+		title: "Test Report",
+		tags:  map[string]string{},
+	}
+	for _, opt := range opts {
+		opt(cfg)
+	}
+	return &domain.Report{Title: cfg.title, Tags: cfg.tags}
+}
