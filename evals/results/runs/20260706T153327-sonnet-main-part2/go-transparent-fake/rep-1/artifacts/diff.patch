diff --git a/hash/contract/hasher.go b/hash/contract/hasher.go
new file mode 100644
index 0000000..67ab230
--- /dev/null
+++ b/hash/contract/hasher.go
@@ -0,0 +1,28 @@
+package contract
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"evalfixture/hash"
+)
+
+// RunHasherContract verifies any Hasher implementation. Run it against every
+// fake AND the real implementation so the fake can't drift.
+func RunHasherContract(t *testing.T, hasher hash.Hasher) {
+	t.Helper()
+
+	t.Run("produces a hash different from the input", func(t *testing.T) {
+		hashed := hasher.Hash("s3cr3t")
+
+		assert.NotEqual(t, "s3cr3t", hashed)
+	})
+
+	t.Run("correctly verifies a value against its hash", func(t *testing.T) {
+		hashed := hasher.Hash("s3cr3t")
+
+		assert.True(t, hasher.Verify("s3cr3t", hashed))
+		assert.False(t, hasher.Verify("wrong", hashed))
+	})
+}
