+package fakes
+
+// FakeHasher is a transparent fake: output is a deterministic, readable
+// function of the input so tests can assert on both sides.
+type FakeHasher struct{}
+
+func NewFakeHasher() *FakeHasher {
+	return &FakeHasher{}
+}
+
+func (f *FakeHasher) Hash(value string) string {
+	return "hashed:" + value
+}
+
+func (f *FakeHasher) Verify(value, hashed string) bool {
+	return f.Hash(value) == hashed
+}
