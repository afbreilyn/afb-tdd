+++ b/hash/hash.go
@@ -0,0 +1,8 @@
+package hash
+
+// Hasher hashes plaintext values so they never need to be stored as-is.
+// Implementations: fakes (transparent, in-memory) and sha256hash (real).
+type Hasher interface {
+	Hash(value string) string
+	Verify(value, hashed string) bool
+}
diff --git a/hash/sha256hash/sha256hash.go b/hash/sha256hash/sha256hash.go
new file mode 100644
index 0000000..034aa01
--- /dev/null
+++ b/hash/sha256hash/sha256hash.go
@@ -0,0 +1,24 @@
+// Package sha256hash is the "real" Hasher implementation: values hashed
+// with crypto/sha256 and hex-encoded. It exists so the contract suite has a
+// second subject alongside the fake.
+package sha256hash
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+)
+
+type Hasher struct{}
+
+func NewHasher() *Hasher {
+	return &Hasher{}
+}
+
+func (h *Hasher) Hash(value string) string {
+	sum := sha256.Sum256([]byte(value))
+	return hex.EncodeToString(sum[:])
+}
+
+func (h *Hasher) Verify(value, hashed string) bool {
+	return h.Hash(value) == hashed
+}
