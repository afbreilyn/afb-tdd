@@ -0,0 +1,33 @@
+package contract
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"evalfixture/hasher"
+)
+
+// RunHasherContract verifies any Hasher implementation. Run it against every
+// fake AND the real implementation so the fake can't drift.
+func RunHasherContract(t *testing.T, h hasher.Hasher) {
+	t.Helper()
+
+	t.Run("hash differs from the plaintext", func(t *testing.T) {
+		hash := h.Hash("s3cr3t")
+
+		assert.NotEqual(t, "s3cr3t", hash)
+	})
+
+	t.Run("Verify returns false for a password that does not match the hash", func(t *testing.T) {
+		hash := h.Hash("s3cr3t")
+
+		assert.False(t, h.Verify("wrong-password", hash))
+	})
+
+	t.Run("Verify returns true for the correct password", func(t *testing.T) {
+		hash := h.Hash("s3cr3t")
+
+		assert.True(t, h.Verify("s3cr3t", hash))
+	})
+}
