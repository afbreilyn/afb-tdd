+package fakes
+
+// FakeHasher is a transparent implementation: the hash is a deterministic,
+// human-readable function of the input so tests can assert on both sides.
+type FakeHasher struct{}
+
+func NewFakeHasher() *FakeHasher {
+	return &FakeHasher{}
+}
+
+func (FakeHasher) Hash(password string) string {
+	return "hashed:" + password
+}
+
+func (FakeHasher) Verify(password, hash string) bool {
+	return "hashed:"+password == hash
+}
