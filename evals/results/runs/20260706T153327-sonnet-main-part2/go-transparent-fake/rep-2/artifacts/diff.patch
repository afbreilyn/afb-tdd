new file mode 100644
index 0000000..2c114d5
--- /dev/null
+++ b/hasher/hasher.go
@@ -0,0 +1,28 @@
+package hasher
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+)
+
+// Hasher hashes passwords for storage and verifies plaintext against a hash.
+type Hasher interface {
+	Hash(password string) string
+	Verify(password, hash string) bool
+}
+
+// SHA256Hasher hashes passwords with SHA-256, hex-encoded.
+type SHA256Hasher struct{}
+
+func NewSHA256Hasher() *SHA256Hasher {
+	return &SHA256Hasher{}
+}
+
+func (SHA256Hasher) Hash(password string) string {
+	sum := sha256.Sum256([]byte(password))
+	return hex.EncodeToString(sum[:])
+}
+
+func (h SHA256Hasher) Verify(password, hash string) bool {
+	return h.Hash(password) == hash
+}
