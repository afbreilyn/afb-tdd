new file mode 100644
index 0000000..88f3c5c
--- /dev/null
+++ b/hashing/contract/hasher.go
@@ -0,0 +1,33 @@
+package contract
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"evalfixture/hashing"
+)
+
+// RunHasherContract verifies any Hasher implementation. Run it against
+// every fake AND the real implementation so the fake can't drift.
+func RunHasherContract(t *testing.T, hasher hashing.Hasher) {
+	t.Helper()
+
+	t.Run("never returns the plaintext input", func(t *testing.T) {
+		hashed := hasher.Hash("secret")
+
+		assert.NotEqual(t, "secret", hashed)
+	})
+
+	t.Run("rejects the wrong password", func(t *testing.T) {
+		hashed := hasher.Hash("secret")
+
+		assert.False(t, hasher.Verify("wrong", hashed))
+	})
+
+	t.Run("accepts the correct password", func(t *testing.T) {
+		hashed := hasher.Hash("secret")
+
+		assert.True(t, hasher.Verify("secret", hashed))
+	})
+}
diff --git a/hashing/fakes/hasher.go b/hashing/fakes/hasher.go
new file mode 100644
index 0000000..2738598
--- /dev/null
+++ b/hashing/fakes/hasher.go
@@ -0,0 +1,19 @@
+// Package fakes provides in-memory, transparent test doubles for the hashing
+// package's interfaces.
+package fakes
+
+// FakeHasher is a transparent fake: its output encodes the input so tests
+// can assert on both sides without depending on the real hash algorithm.
+type FakeHasher struct{}
+
+func NewFakeHasher() *FakeHasher {
+	return &FakeHasher{}
+}
+
+func (f *FakeHasher) Hash(value string) string {
+	return "hashed:" + value
+}
+
+func (f *FakeHasher) Verify(plain, hashed string) bool {
+	return f.Hash(plain) == hashed
+}
