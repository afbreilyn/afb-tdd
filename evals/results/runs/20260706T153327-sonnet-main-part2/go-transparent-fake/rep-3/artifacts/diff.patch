new file mode 100644
index 0000000..e3c534b
--- /dev/null
+++ b/hashing/hashing.go
@@ -0,0 +1,12 @@
+// Package hashing defines the Hasher contract used to store and verify
+// passwords without ever persisting them as plaintext. Implementations:
+// fakes (in-memory, transparent) and sha256hasher (crypto/sha256-backed).
+// Both must satisfy the shared contract suite in hashing/contract.
+package hashing
+
+// Hasher hashes plaintext values and verifies a plaintext against a
+// previously computed hash.
+type Hasher interface {
+	Hash(value string) string
+	Verify(plain, hashed string) bool
+}
diff --git a/hashing/sha256hasher/hasher.go b/hashing/sha256hasher/hasher.go
new file mode 100644
index 0000000..99fc202
--- /dev/null
+++ b/hashing/sha256hasher/hasher.go
@@ -0,0 +1,23 @@
+// Package sha256hasher is the "real" Hasher implementation, backed by the
+// standard library's crypto/sha256.
+package sha256hasher
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+)
+
+type Hasher struct{}
+
+func NewHasher() *Hasher {
+	return &Hasher{}
+}
+
+func (h *Hasher) Hash(value string) string {
+	sum := sha256.Sum256([]byte(value))
+	return hex.EncodeToString(sum[:])
+}
+
+func (h *Hasher) Verify(plain, hashed string) bool {
+	return h.Hash(plain) == hashed
+}
