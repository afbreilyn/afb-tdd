@@ -1,5 +1,5 @@
 import { http, HttpResponse } from "msw";
-import { subscribe } from "./newsletter";
+import { subscribe, unsubscribe } from "./newsletter";
 import { startApiServer } from "./testing/msw";
 import type { ApiRequest } from "./api/client";
 
@@ -10,6 +10,9 @@ const server = startApiServer(
     if (body.method === "newsletter.subscribe") {
       return HttpResponse.json({ subscriberId: `sub-${body.params.email}` });
     }
+    if (body.method === "newsletter.unsubscribe") {
+      return HttpResponse.json({ removed: true });
+    }
     throw new Error("api mock fallthrough");
   }),
 );
@@ -47,3 +50,69 @@ describe("subscribe", () => {
     expect(result.kind).toBe("connection_error");
   });
 });
+
+describe("unsubscribe", () => {
+  it("returns email_error for an empty email", async () => {
+    const result = await unsubscribe("", "product");
+
+    expect(result).toEqual({ kind: "email_error", message: '"" is not a valid email address' });
+  });
+
+  it("returns topic_error for an unknown topic", async () => {
+    const result = await unsubscribe("reader@example.com", "gossip");
+
+    expect(result).toEqual({ kind: "topic_error", message: '"gossip" is not a known topic' });
+  });
+
+  it("returns unsubscribed when the service confirms removal", async () => {
+    server.use(
+      http.post("/api", async ({ request }) => {
+        const body = (await request.json()) as ApiRequest;
+
+        expect(body).toEqual({
+          method: "newsletter.unsubscribe",
+          params: { email: "reader@example.com", topic: "product" },
+        });
+        return HttpResponse.json({ removed: true });
+      }),
+    );
+
+    const result = await unsubscribe("reader@example.com", "product");
+
+    expect(result).toEqual({ kind: "unsubscribed" });
+  });
+
+  it("returns connection_error when the service is unreachable", async () => {
+    server.use(http.post("/api", () => HttpResponse.error()));
+
+    const result = await unsubscribe("reader@example.com", "product");
+
+    expect(result.kind).toBe("connection_error");
+  });
+
+  it("returns not_subscribed_error when the address isn't subscribed to the topic", async () => {
+    server.use(
+      http.post("/api", () => HttpResponse.json({ error: "not_subscribed" }, { status: 404 })),
+    );
+
+    const result = await unsubscribe("reader@example.com", "product");
+
+    expect(result.kind).toBe("not_subscribed_error");
+  });
+
+  it("returns response_error for an unexpected response shape", async () => {
+    server.use(http.post("/api", () => HttpResponse.json({ unexpected: "field" })));
+
+    const result = await unsubscribe("reader@example.com", "product");
+
+    expect(result.kind).toBe("response_error");
+  });
+
+  it("returns response_error for an error body other than not_subscribed", async () => {
+    server.use(http.post("/api", () => HttpResponse.json({ error: "rate_limited" })));
+
+    const result = await unsubscribe("reader@example.com", "product");
+
+    expect(result.kind).toBe("response_error");
+  });
+});
